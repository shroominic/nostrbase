{
  "name": "nostrbase-docs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "prepare-content": "node scripts/prepare-content.mjs",
    "dev": "npm run prepare-content && astro dev --host 127.0.0.1",
    "build": "npm run prepare-content && node scripts/check-examples.mjs && astro check && astro build && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.3.5",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
