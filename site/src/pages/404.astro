---
import DocsLayout from "../layouts/DocsLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = (value: string) => `${base}${value}`;
---
<DocsLayout title="Page not found" description="This documentation page does not exist." home><section class="not-found"><span class="eyebrow">404</span><h1>Page not found</h1><p>Use search or open the documentation index.</p><a class="primary-button" href={path("/")}>Documentation index →</a></section></DocsLayout>
