---
import Icon from "./Icon.astro";
---
<meta name="nostrbase-base" content={import.meta.env.BASE_URL} />
<dialog id="search-dialog" aria-labelledby="search-title">
  <div class="search-input-row">
    <Icon name="search" size={20} />
    <label class="sr-only" for="search-input" id="search-title">Search documentation</label>
    <input id="search-input" type="search" placeholder="Search documentation…" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="search-results" aria-autocomplete="list" />
    <button class="search-close" aria-label="Close search"><kbd>esc</kbd></button>
  </div>
  <p class="search-status" id="search-status" role="status">Search guides, API methods, and protocols.</p>
  <div id="search-results" role="listbox" aria-label="Search results"></div>
  <div class="search-footer"><span><kbd>↑</kbd> <kbd>↓</kbd> to navigate <kbd>↵</kbd> to open</span><span>Local search · no tracking</span></div>
</dialog>
<script>
  type SearchEntry = { title: string; group: string; heading: string; url: string; text: string };
  const dialog = document.querySelector<HTMLDialogElement>("#search-dialog")!;
  const input = document.querySelector<HTMLInputElement>("#search-input")!;
  const results = document.querySelector<HTMLDivElement>("#search-results")!;
  const status = document.querySelector<HTMLParagraphElement>("#search-status")!;
  let index: SearchEntry[] | undefined;
  let selected = -1;
  let items: HTMLAnchorElement[] = [];
  let opener: HTMLElement | null = null;
  const basePath = document.querySelector<HTMLMetaElement>("meta[name=nostrbase-base]")?.content.replace(/\/$/, "") ?? "";
  function select(position: number) {
    if (!items.length) return;
    selected = (position + items.length) % items.length;
    items.forEach((item, i) => item.setAttribute("aria-selected", String(i === selected)));
    input.setAttribute("aria-activedescendant", items[selected].id);
    items[selected].scrollIntoView({ block: "nearest" });
  }
  function render() {
    if (!index) return;
    const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    results.replaceChildren();
    items = [];
    selected = -1;
    input.removeAttribute("aria-activedescendant");
    if (!words.length) {
      status.textContent = "Search guides, API methods, and protocols.";
      return;
    }
    const matches = index.map(entry => {
      const title = `${entry.title} ${entry.heading}`.toLowerCase();
      const text = entry.text.toLowerCase();
      const score = words.every(word => `${title} ${text}`.includes(word))
        ? words.reduce((total, word) => total + (title.includes(word) ? 12 : 1), 0) + (title === input.value.toLowerCase().trim() ? 50 : 0)
        : 0;
      return { entry, score };
    }).filter(match => match.score > 0).sort((a, b) => b.score - a.score).slice(0, 16);
    status.textContent = matches.length ? `${matches.length} results` : "No results. Try a method name, feature, or error code.";
    for (const { entry } of matches) {
      const link = document.createElement("a");
      link.href = entry.url;
      link.className = "search-result";
      link.id = `search-result-${items.length}`;
      link.setAttribute("role", "option");
      link.setAttribute("aria-selected", "false");
      const context = document.createElement("span");
      context.className = "search-context";
      context.textContent = `${entry.group} / ${entry.title}`;
      const title = document.createElement("strong");
      title.textContent = entry.heading || entry.title;
      const snippet = document.createElement("p");
      const offset = Math.max(0, entry.text.toLowerCase().indexOf(words[0]) - 55);
      snippet.textContent = `${offset ? "…" : ""}${entry.text.slice(offset, offset + 150)}${entry.text.length > offset + 150 ? "…" : ""}`;
      link.append(context, title, snippet);
      const position = items.length;
      link.addEventListener("pointermove", () => select(position));
      results.append(link);
      items.push(link);
    }
    if (items.length) select(0);
  }
  async function openSearch() {
    opener = document.activeElement as HTMLElement;
    dialog.showModal();
    input.focus();
    if (!index) {
      status.textContent = "Loading search index…";
      try {
        const response = await fetch(`${basePath}/search.json`);
        if (!response.ok) throw new Error("Search index unavailable");
        index = await response.json();
      } catch {
        status.textContent = "Search is unavailable. Use the sidebar to open a guide.";
        return;
      }
    }
    render();
  }
  document.querySelectorAll("[data-search]").forEach(button => button.addEventListener("click", openSearch));
  dialog.querySelector(".search-close")!.addEventListener("click", () => dialog.close());
  dialog.addEventListener("close", () => opener?.focus());
  dialog.addEventListener("click", event => {
    if (event.target !== dialog) return;
    const box = dialog.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close();
  });
  input.addEventListener("input", render);
  input.addEventListener("keydown", event => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      select(selected + (event.key === "ArrowDown" ? 1 : -1));
    }
    if (event.key === "Enter" && items[selected]) {
      event.preventDefault();
      window.location.assign(items[selected].href);
    }
  });
  document.addEventListener("keydown", event => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (dialog.open) dialog.close(); else void openSearch();
    }
  });
</script>
