{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "nostrbase": ["./src/index.ts"],
      "nostrbase/node": ["./src/node.ts"]
    },
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "tests",
    "examples",
    "tsup.config.ts",
    "vitest.config.ts",
    "vitest.baseline.config.ts",
    "vitest.environment.config.ts",
    "playwright.config.ts",
    "playwright.extension.config.ts"
  ]
}
