{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!package-lock.json",
      "!integration/extension/node_modules",
      "!integration/extension/package-lock.json",
      "!examples/**/dist",
      "!examples/**/node_modules",
      "!examples/**/package-lock.json",
      "!site/dist",
      "!site/.astro",
      "!site/node_modules",
      "!site/package-lock.json",
      "!site/src/content/docs",
      "!.playwright-cli",
      "!output",
      "!examples/fieldwork/package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["site/src/styles/global.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["site/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
